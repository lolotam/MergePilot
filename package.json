{
  "name": "mergepilot",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck && tsc -p scripts/release/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run -c vitest.integration.config.ts",
    "build": "pnpm -r build",
    "bundle": "pnpm --filter @mergepilot/action bundle",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "release": "node --experimental-strip-types scripts/release/main.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
