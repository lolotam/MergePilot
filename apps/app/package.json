{
  "name": "@mergepilot/app",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./contract": {
      "types": "./dist/api/contract.d.ts",
      "default": "./dist/api/contract.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -b",
    "build": "tsc -b",
    "start": "node dist/server/main.js",
    "start:worker": "node dist/worker/main.js",
    "migrate": "node dist/bootstrap/migrate-cli.js"
  },
  "dependencies": {
    "@fastify/helmet": "^13.1.2",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@mergepilot/engine": "workspace:*",
    "@mergepilot/github": "workspace:*",
    "@octokit/app": "^16.1.4",
    "@octokit/rest": "^22.0.1",
    "better-auth": "^1.7.7",
    "bullmq": "^6.3.12",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1"
  }
}
