# ==============================================================================
# MergePilot Environment Variables Example (نموذج إعداد المتغيرات البيئية)
# ==============================================================================
# ملاحظة هامة: لا تضع أي قيم أو أسرار حقيقية داخل هذا الملف.
# لتوليد المفاتيح السرية المشفرة (32 بايت بصيغة Base64)، نفذ الأمر التالي في الطرفية:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# ==============================================================================

# الرابط الأساسي للخدمة عبر الدومين المربوط بالسيرفر (بدون شرطة مائلة في النهاية)
MERGEPILOT_BASE_URL=https://mergepilot.walidmohamed.com

# بيانات قاعدة البيانات. ملفات compose بتبني DATABASE_URL وREDIS_URL منها لوحدها.
# كلمة السر: طلّعها بالأمر اللي فوق (أي نص عشوائي طويل).
POSTGRES_DB=mergepilot
POSTGRES_USER=mergepilot
POSTGRES_PASSWORD=changeme_long_random_password


# مفتاح التشفير الرئيسي لتشفير مفاتيح API الخاصة بالمستخدمين (AES-256-GCM، 32 بايت مشفرة Base64)
MERGEPILOT_MASTER_KEY=changeme_base64_32_bytes_key_000000000000=

# تدوير مفتاح التشفير (اختياري): لما تغيّر MERGEPILOT_MASTER_KEY، حط القديم هنا وزوّد رقم النسخة
MERGEPILOT_MASTER_KEY_VERSION=1
MERGEPILOT_MASTER_KEY_PREVIOUS=

# المعرف الرقمي لتطبيق GitHub App (App ID من صفحة إعدادات التطبيق في GitHub)
GITHUB_APP_ID=123456

# الاسم التعريفي العام لتطبيق GitHub App (يستخدم في رابط التثبيت وفي اسم البوت)
GITHUB_APP_SLUG=mergepilot

# المفتاح الخاص لتطبيق GitHub App بصيغة PEM (يمكن كتابته متعدد الأسطر أو فواصل \n)
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA000000000000000000000000000000000000000000000000\n-----END RSA PRIVATE KEY-----"

# السر المخصص للتحقق من صحة وتوقيع إشعارات الـ Webhook الواردة من GitHub
GITHUB_WEBHOOK_SECRET=changeme_github_webhook_secret_here

# معرّف العميل لتطبيق GitHub OAuth المدمج مع الـ GitHub App
GITHUB_CLIENT_ID=Iv1.0123456789abcdef

# سر العميل لتطبيق GitHub OAuth المدمج مع الـ GitHub App
GITHUB_CLIENT_SECRET=changeme_github_client_secret_here

# معرّف العميل لتسجيل الدخول بحساب Google من منصة Google Cloud Console
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# سر العميل لتسجيل الدخول بحساب Google من منصة Google Cloud Console
GOOGLE_CLIENT_SECRET=GOCSPX-changeme_google_client_secret

# سر تشفير وتوقيع الجلسات والكوكيز لنظام Better Auth (32 بايت بصيغة Base64)
BETTER_AUTH_SECRET=changeme_base64_32_bytes_better_auth_secret=

# عدد المراجعات المتزامنة التي يعالجها كل Worker في الخلفية (الافتراضي 2)
WORKER_CONCURRENCY=2

# إيميلات مشغّلي المنصة اللي يقدروا يفتحوا /admin (مفصولة بفاصلة). فاضي = محدش.
MERGEPILOT_PLATFORM_ADMINS=
